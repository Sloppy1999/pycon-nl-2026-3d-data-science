  "cluster_min_height_m": 0.3,
  "rules": {
   "order": "first rule that fires wins; rules 3 and 4 use distances to the results of rules 1 and 2",
   "source": [
    "def name(c):",
    "    if c.multi > 0.4 and c.top > 1:",
    "        return VEGETATION",
    "    if c.foot > 25 and c.top > 2.5:",
    "        return BUILDINGS",
    "    if c.to_building < 2:  # facade",
    "        return BUILDINGS",
    "    if c.slender and c.free:",
    "        return STREET_FURNITURE",
    "    return UNLABELLED"
   ],
   "slender": [
    "@property",
    "    def slender(self) -> bool:",
    "        # pole-like: at most 1.5 m wide, taller than 1.5 m, at least twice as tall as it is wide, and",
    "        # below 15 m. A car (about 1.5 m tall, 1.8 m wide) fails \"twice as tall as wide\".",
    "        return self.width <= 1.5 and 1.5 < self.top <= 15 and self.top >= 2 * self.width"
   ],
   "free": [
    "@property",
    "    def free(self) -> bool:",
    "        # free-standing: more than 2 m from any building and more than 1 m from any tree (plan view)",
    "        return self.to_building > 2 and self.to_vegetation > 1"
   ],
   "features": {
    "top": "highest point above local ground (m)",
    "foot": "occupied 1 m x 1 m cells (m2)",
    "multi": "share of points with number_of_returns > 1 (carried through voxel downsampling in a colour channel)",
    "width": "largest horizontal extent (m)",
    "to_building": "plan-view distance to the nearest point of a rule-2 building (m)",
    "to_vegetation": "plan-view distance to the nearest point of rule-1 vegetation (m)",
    "height_above_ground": "z minus z of the nearest ground voxel in plan view"
   }
  }
 },
 "params_why": {
  "note": "each reason points at a row of param_choice (one parameter changed, everything else final)",
  "voxel": "0.5 m, as approved in the storyboard",
  "tile": "25 m: ground recall 0.9427 against 0.8515 for 50 m tiles ('tile 50 m'); one plane for the whole crop scores 0.9457 here ('one plane (tile 250 m)'): this ground is flat, the first example street's was not (previous_street), so the tiles stay",
  "ransac_threshold": "0.4 m: 0.2 m misses more of the uneven ground ('RANSAC threshold 0.2 m')",
  "low_prefilter": "without it RANSAC fits roofs and facades in several tiles, which the plausibility check then has to catch ('no low-point pre-filter', tiles_flagged)",
  "low_window": "1.5 m, kept from the first example street (not re-tuned: the sweep is scored against the same AHN classes it would tune on); 'pre-filter window 3 m' here: ground recall 0.9662 against 0.9427, building precision 0.8242 against 0.8342",
  "eps": "0.75 m (1.5 voxels): 0.5 m, the voxel size, leaves most voxels as noise and finds no building; 1.0 m glues buildings to trees and building recall collapses ('eps 0.5', 'eps 1.0')",
  "min_points": "6: 5 lets a tree fuse with a building (lower building recall); 10 turns more than half of the voxels into noise ('min_points 5', 'min_points 10')",
  "cluster_min_height": "0.3 m: without it, ground that RANSAC missed links objects together, building precision drops and more AHN ground becomes vegetation ('no near-ground skip')"
