  "cluster_min_height_m": 0.3,
  "rules": {
   "order": "first rule that fires wins; rules 3 and 4 use distances to the results of rules 1 and 2",
   "source": [
    "def name(c):",
    "    if c.multi > 0.4 and c.top > 1:",
    "        return VEGETATION",
    "    if c.foot > 25 and c.top > 2.5:",
    "        return BUILDINGS",
    "    if c.to_building < 2:  # facade",
    "        return BUILDINGS",
    "    if c.slender and c.free:",
    "        return STREET_FURNITURE",
    "    return UNLABELLED"
   ],
   "slender": [
    "@property",
    "    def slender(self) -> bool:",
    "        # pole-like: at most 1.5 m wide, taller than 1.5 m, at least twice as tall as it is wide, and",
    "        # below 15 m. A car (about 1.5 m tall, 1.8 m wide) fails \"twice as tall as wide\".",
    "        return self.width <= 1.5 and 1.5 < self.top <= 15 and self.top >= 2 * self.width"
   ],
   "free": [
    "@property",
    "    def free(self) -> bool:",
    "        # free-standing: more than 2 m from any building and more than 1 m from any tree (plan view)",
    "        return self.to_building > 2 and self.to_vegetation > 1"
   ],
   "features": {
    "top": "highest point above local ground (m)",
    "foot": "occupied 1 m x 1 m cells (m2)",
    "multi": "share of points with number_of_returns > 1 (carried through voxel downsampling in a colour channel)",
    "width": "largest horizontal extent (m)",
    "to_building": "plan-view distance to the nearest point of a rule-2 building (m)",
    "to_vegetation": "plan-view distance to the nearest point of rule-1 vegetation (m)",
    "height_above_ground": "z minus z of the nearest ground voxel in plan view"
   }
  }
 },
